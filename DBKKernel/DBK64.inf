;
; mydfdriver64.inf
;

[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%ManufacturerName%
CatalogFile=mydfdriver64.cat
DriverVer= ; TODO: set DriverVer in stampinf property pages

[DestinationDirs]
DefaultDestDir = 12
mydfdriver64_Device_CoInstaller_CopyFiles = 11

; ================= Class section =====================

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
mydfdriver64.sys  = 1,,
WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll=1 ; make sure the number matches with SourceDisksNames

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName%=Standard,NT$ARCH$

[Standard.NT$ARCH$]
%mydfdriver64.DeviceDesc%=mydfdriver64_Device, Root\mydfdriver64 ; TODO: edit hw-id

[mydfdriver64_Device.NT]
CopyFiles=Drivers_Dir

[Drivers_Dir]
mydfdriver64.sys

;-------------- Service installation
[mydfdriver64_Device.NT.Services]
AddService = mydfdriver64,%SPSVCINST_ASSOCSERVICE%, mydfdriver64_Service_Inst

; -------------- mydfdriver64 driver install sections
[mydfdriver64_Service_Inst]
DisplayName    = %mydfdriver64.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\mydfdriver64.sys

;
;--- mydfdriver64_Device Coinstaller installation ------
;

[mydfdriver64_Device.NT.CoInstallers]
AddReg=mydfdriver64_Device_CoInstaller_AddReg
CopyFiles=mydfdriver64_Device_CoInstaller_CopyFiles

[mydfdriver64_Device_CoInstaller_AddReg]
HKR,,CoInstallers32,0x00010000, "WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll,WdfCoInstaller"

[mydfdriver64_Device_CoInstaller_CopyFiles]
WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll

[mydfdriver64_Device.NT.Wdf]
KmdfService =  mydfdriver64, mydfdriver64_wdfsect
[mydfdriver64_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE= 0x00000002
ManufacturerName="mydfdriver64" ;TODO: Replace with your manufacturer name
ClassName="System" ; TODO: edit ClassName
DiskName = "mydfdriver64 Installation Disk"
mydfdriver64.DeviceDesc = "mydfdriver64 Device"
mydfdriver64.SVCDESC = "mydfdriver64 Service"
