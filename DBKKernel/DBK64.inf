;
; myk64.inf
;

[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%ManufacturerName%
CatalogFile=myk64.cat
DriverVer= ; TODO: set DriverVer in stampinf property pages

[DestinationDirs]
DefaultDestDir = 12
myk64_Device_CoInstaller_CopyFiles = 11

; ================= Class section =====================

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
myk64.sys  = 1,,
WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll=1 ; make sure the number matches with SourceDisksNames

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName%=Standard,NT$ARCH$

[Standard.NT$ARCH$]
%myk64.DeviceDesc%=myk64_Device, Root\myk64 ; TODO: edit hw-id

[myk64_Device.NT]
CopyFiles=Drivers_Dir

[Drivers_Dir]
myk64.sys

;-------------- Service installation
[myk64_Device.NT.Services]
AddService = myk64,%SPSVCINST_ASSOCSERVICE%, myk64_Service_Inst

; -------------- myk64 driver install sections
[myk64_Service_Inst]
DisplayName    = %myk64.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\myk64.sys

;
;--- myk64_Device Coinstaller installation ------
;

[myk64_Device.NT.CoInstallers]
AddReg=myk64_Device_CoInstaller_AddReg
CopyFiles=myk64_Device_CoInstaller_CopyFiles

[myk64_Device_CoInstaller_AddReg]
HKR,,CoInstallers32,0x00010000, "WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll,WdfCoInstaller"

[myk64_Device_CoInstaller_CopyFiles]
WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll

[myk64_Device.NT.Wdf]
KmdfService =  myk64, myk64_wdfsect
[myk64_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE= 0x00000002
ManufacturerName="myk64" ;TODO: Replace with your manufacturer name
ClassName="System" ; TODO: edit ClassName
DiskName = "myk64 Installation Disk"
myk64.DeviceDesc = "myk64 Device"
myk64.SVCDESC = "myk64 Service"
